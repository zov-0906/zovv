<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- LDPlayer's Vulkan texture path can stall when video surfaces switch.
         Use the compatibility renderer for local debug builds only. -->
    <application android:networkSecurityConfig="@xml/local_gateway_network">
        <meta-data android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
